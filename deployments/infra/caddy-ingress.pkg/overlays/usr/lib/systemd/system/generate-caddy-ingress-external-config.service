[Unit]
Description=Generate (with string interpolation) a Caddyfile template into a Caddyfile for ingress proxying from external peers with Tailscale
Requires=tailscaled.service
After=tailscaled.service
Before=forklift-apply.service
ConditionFileIsExecutable=/usr/libexec/render-templated-config
ConditionFileNotEmpty=/etc/caddy-ingress/external/Caddyfile.template

[Service]
Type=oneshot
ExecStartPre=mkdir -p /run/caddy-ingress/external
ExecStartPre=touch /run/caddy-ingress/external/Caddyfile
ExecStart=sh -c "\
cat /etc/caddy-ingress/external/Caddyfile.template | \
/usr/libexec/render-templated-config \
>/run/caddy-ingress/external/Caddyfile.new; \
if ! diff /run/caddy-ingress/external/Caddyfile /run/caddy-ingress/external/Caddyfile.new; then \
mv /run/caddy-ingress/external/Caddyfile.new /run/caddy-ingress/external/Caddyfile; \
fi \
"
# TODO: if the new Caddyfile is different from the old one or if the old one doesn't exist, do an atomic file move

[Install]
WantedBy=forklift-apply.service
