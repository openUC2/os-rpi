[Unit]
Description=Load pre-downloaded container images from %f's cache into Docker
Requires=docker.service
After=docker.service
Before=forklift-apply.service
ConditionPathExists=%f/.cache/forklift/containers/docker-archives

[Service]
Type=oneshot
Environment=CACHE_PATH=%f/.cache/forklift/containers/docker-archives
Environment=FORKLIFT_WORKSPACE=%f
ExecStart=bash -c -e 'forklift plt ls-img | while read image; do \
  precached_image="$CACHE_PATH/$image.tar"; \
  if [ -f "$precached_image" ]; then \
    echo "Loading $image from $precached_image..."; \
    ctr -n moby image import "$precached_image" && \
      rm "$precached_image"; \
  fi; \
done && echo "Done!"'
RemainAfterExit=yes

[Install]
WantedBy=forklift-apply.service
